#!/usr/bin/env bash
# Developed by Mohammad Rameez Imdad (Rameez Scripts)
# WhatsApp: https://wa.me/923435347417 (For Custom Projects)
# YouTube: https://www.youtube.com/@rameezimdad (Subscribe for more!)
# claude-auto: Claude Code across several accounts. Usage limit hit -> the same
# session resumes on the next account that still has usage left.
HOME_DIR="${CLAUDE_AUTO_HOME:-$HOME/.local/share/claude-auto}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/claude-auto/accounts"
USAGE="$HOME_DIR/lib/usage.py"
MAIN="$HOME/.claude"
MAX=${CLAUDE_AUTO_MAX:-95}   # % used = treat as full
SHARE=(projects settings.json settings.local.json CLAUDE.md skills plugins agents commands hooks output-styles plans paste-cache file-history todos)

accts() { [ -f "$CONF" ] && sed -e 's/#.*//' -e "s|^~|$HOME|" -e '/^\s*$/d' "$CONF" || echo "$MAIN"; }
name() { [ "$1" = "$MAIN" ] && echo "account 1 (~/.claude)" || echo "${1/#$HOME/\~}"; }
# logged-in email of an account (default dir keeps it in ~/.claude.json)
email() {
  local f="$1/.claude.json"; [ "$1" = "$MAIN" ] && f="$HOME/.claude.json"
  python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("oauthAccount",{}).get("emailAddress",""))
except Exception: pass' "$f"
}
label() { local e; e=$(email "$1"); echo "$(name "$1")${e:+ <$e>}"; }
usage() { python3 "$USAGE" "$1"; }

cmd_status() {
  local a pct reset
  for a in $(accts); do
    read -r pct reset < <(usage "$a")
    case "$pct" in
      NOLOGIN) printf '%-58s not logged in\n' "$(label "$a")" ;;
      UNKNOWN) printf '%-58s usage unknown (token expired or offline)\n' "$(label "$a")" ;;
      *) printf '%-58s %3s%% used%s\n' "$(label "$a")" "$pct" \
           "$([ "$reset" -gt 0 ] && echo ", resets $(python3 -c "import time;print(time.strftime('%a %H:%M',time.localtime($reset)))")")" ;;
    esac
  done
}

cmd_add() {
  local n=$1 dir f
  # no number -> next free one (2, 3, 4 ...)
  if [ -z "$n" ]; then n=2; while [ -e "$HOME/.claude-$n" ] || grep -qxF "$HOME/.claude-$n" "$CONF" 2>/dev/null; do n=$((n + 1)); done; fi
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 2 ] || { echo "usage: claude-auto add [number]   e.g. claude-auto add 4" >&2; exit 1; }
  dir="$HOME/.claude-$n"
  mkdir -p "$dir" "$MAIN"
  # share history, settings, skills with the main account so a session can move
  for f in "${SHARE[@]}"; do
    [ -e "$MAIN/$f" ] || [ "$f" = projects ] || continue
    [ "$f" = projects ] && mkdir -p "$MAIN/projects"
    [ -e "$dir/$f" ] && [ ! -L "$dir/$f" ] && { echo "  keeping existing $dir/$f (not shared)"; continue; }
    ln -sfn "$MAIN/$f" "$dir/$f"
  done
  mkdir -p "$(dirname "$CONF")"; touch "$CONF"
  grep -qxF "$dir" "$CONF" || echo "$dir" >> "$CONF"
  echo "Account $n ready: $dir"
  [ -n "$CLAUDE_AUTO_NOLOGIN" ] && return
  if [ -t 0 ]; then
    read -rp "Log in to account $n now? [Y/n] " yn
    [[ "$yn" =~ ^[Nn] ]] || { cmd_login "$n"; return; }
  fi
  echo "Log it in later:  claude-auto login $n"
}

# open claude on one account to run /login
cmd_login() {
  local n=$1 dir
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "usage: claude-auto login <number>   (1 = ~/.claude)" >&2; exit 1; }
  [ "$n" = 1 ] && dir=$MAIN || dir="$HOME/.claude-$n"
  [ -d "$dir" ] || { echo "No account $n yet. Run: claude-auto add $n" >&2; exit 1; }
  echo "Type /login, sign in with the Claude account for slot $n, then type /exit."
  if [ "$dir" = "$MAIN" ]; then env -u CLAUDE_CONFIG_DIR claude; else env CLAUDE_CONFIG_DIR="$dir" claude; fi
}

# take an account out of the rotation (folder + login are kept)
# switch the running session to another account by hand (run inside the session)
cmd_switch() {
  local want=$1 cur tgt pct _
  [ -n "$CLAUDE_AUTO_FLAG" ] && [ -n "$CLAUDE_CODE_SESSION_ID" ] && [ -n "$CLAUDE_PID" ] || {
    echo "Run this inside a session started with claude-auto, e.g.  ! claude-auto switch 2   or  /switch 2" >&2; exit 1; }
  cur="${CLAUDE_CONFIG_DIR:-$MAIN}"; cur=${cur%/}
  if [ -z "$want" ]; then
    pick "$cur"; tgt=$PICK
    [ -n "$tgt" ] || { echo "No other account has usage left. Run: claude-auto status" >&2; exit 1; }
  else
    [[ "$want" =~ ^[0-9]+$ ]] || { echo "usage: claude-auto switch [account number]" >&2; exit 1; }
    tgt=$(accts | sed -n "${want}p")
    [ -n "$tgt" ] || { echo "No account $want. Run: claude-auto accounts" >&2; exit 1; }
    read -r pct _ < <(usage "$tgt")
    [ "$pct" = NOLOGIN ] && { echo "Account $want is not logged in. Run: claude-auto login $want" >&2; exit 1; }
    [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -ge "$MAX" ] && { echo "Account $want is at ${pct}% used. Pick another: claude-auto status" >&2; exit 1; }
  fi
  [ "$tgt" = "$cur" ] && { echo "Already on $(label "$cur")."; exit 0; }
  printf '%s\n%s\n' "$CLAUDE_CODE_SESSION_ID" "$tgt" > "$CLAUDE_AUTO_FLAG"
  echo "Switching this session to $(label "$tgt")..."
  kill -TERM "$CLAUDE_PID"
}

cmd_remove() {
  local n=$1 dir
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 2 ] || { echo "usage: claude-auto remove <number>" >&2; exit 1; }
  dir="$HOME/.claude-$n"
  [ -f "$CONF" ] && grep -vxF "$dir" "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
  echo "Account $n removed from rotation. Folder kept: $dir"
}

# first account with room, skipping $1. sets PICK and WAIT_UNTIL (epoch)
pick() {
  PICK=; WAIT_UNTIL=0; local a pct reset maybe=
  for a in $(accts); do
    [ "$a" = "$1" ] && continue
    read -r pct reset < <(usage "$a")
    case "$pct" in
      NOLOGIN) echo "  $(name "$a"): not logged in, skipped" >&2 ;;
      UNKNOWN) echo "  $(name "$a"): usage unknown" >&2; maybe=${maybe:-$a} ;;
      *) echo "  $(name "$a"): ${pct}% used" >&2
         [ "$pct" -lt "$MAX" ] && { PICK=$a; return; }
         [ "$reset" -gt 0 ] && { [ "$WAIT_UNTIL" -eq 0 ] || [ "$reset" -lt "$WAIT_UNTIL" ]; } && WAIT_UNTIL=$reset ;;
    esac
  done
  PICK=$maybe   # expired token: claude refreshes it on start
}

# bring the session's state to the next account when its folders are not shared
carry() {
  local from=$1 to=$2 sid=$3 src f
  same() { [ "$(cd "$from/$1" 2>/dev/null && pwd -P)" = "$(cd "$to/$1" 2>/dev/null && pwd -P)" ]; }
  if ! same projects; then
    src=$(find "$from/projects" -name "$sid.jsonl" 2>/dev/null | head -1)
    [ -n "$src" ] && mkdir -p "$to/projects/$(basename "$(dirname "$src")")" && cp "$src" "$to/projects/$(basename "$(dirname "$src")")/"
    [ -d "${src%.jsonl}" ] && cp -R "${src%.jsonl}" "$to/projects/$(basename "$(dirname "$src")")/"   # subagent transcripts
  fi
  # edit checkpoints, todo list, plans, pasted images
  same file-history || { [ -d "$from/file-history/$sid" ] && mkdir -p "$to/file-history" && cp -R "$from/file-history/$sid" "$to/file-history/"; }
  same todos || for f in "$from/todos/$sid"*; do [ -e "$f" ] && mkdir -p "$to/todos" && cp -n "$f" "$to/todos/"; done
  for f in plans paste-cache; do same $f || { [ -d "$from/$f" ] && mkdir -p "$to/$f" && cp -Rn "$from/$f/." "$to/$f/"; }; done
  return 0
}

run() {
  # default dir runs without CLAUDE_CONFIG_DIR so its login (keychain on macOS) stays the same
  # env execs claude, so claude stays a direct child of this script (the hook looks for that)
  local d=$1; shift
  if [ "$d" = "$MAIN" ]; then env -u CLAUDE_CONFIG_DIR claude "$@"
  else env CLAUDE_CONFIG_DIR="$d" claude "$@"; fi
}

case "$1" in
  status) cmd_status; exit ;;
  add) cmd_add "$2"; exit ;;
  login) cmd_login "$2"; exit ;;
  remove) cmd_remove "$2"; exit ;;
  switch) cmd_switch "$2"; exit ;;
  accounts) accts; exit ;;
  help|-h|--help)
    cat <<EOF
claude-auto [claude args]   start Claude Code; switches account when usage runs out
claude-auto status          usage of every account
claude-auto add [n]         add another Claude subscription (next free slot if n is left out)
claude-auto login <n>       log in (or switch login) on account n  (1 = ~/.claude)
claude-auto remove <n>      take account n out of the rotation
claude-auto switch [n]      inside a session: move it to account n now (next with room if n is left out)
claude-auto accounts        list accounts ($CONF)
Env: CLAUDE_AUTO_MAX=95  switch when an account reaches this % used
EOF
    exit ;;
esac

RESUME_MSG="${CLAUDE_AUTO_MSG:-The previous Claude account hit its usage limit in the middle of this task, and this same session has moved to another account. Do NOT start over. Everything you already did is still on disk. First check the real current state (git status / git diff, or re-read the files you were changing) to see exactly how far the work got, then continue from the next unfinished step. Do not redo finished steps, do not recreate files that already exist, and do not ask again for answers already given above.}"

command -v claude >/dev/null || { echo "claude not found on PATH" >&2; exit 1; }
export CLAUDE_AUTO_MAX=$MAX CLAUDE_AUTO_PID=$$
export CLAUDE_AUTO_FLAG="${TMPDIR:-/tmp}/claude-auto.$$"
trap 'rm -f "$CLAUDE_AUTO_FLAG"' EXIT

cur="${CLAUDE_CONFIG_DIR:-}"; args=("$@")
# flags carried over to the resumed session (prompt / resume flags are not)
keep=(); a=("$@")
for ((i = 0; i < ${#a[@]}; i++)); do
  case "${a[i]}" in
    -p|--print|--verbose|--dangerously-skip-permissions|--ide) keep+=("${a[i]}") ;;
    --model|--permission-mode|--output-format|--add-dir|--settings|--agent) keep+=("${a[i]}" "${a[i+1]}"); ((i++)) ;;
    --model=*|--permission-mode=*|--output-format=*|--add-dir=*|--settings=*|--agent=*) keep+=("${a[i]}") ;;
  esac
done
if [ -z "$cur" ]; then echo "claude-auto: checking accounts..." >&2; pick ""; cur=$PICK; fi
while :; do
  if [ -z "$cur" ]; then
    # all full -> wait for the first reset
    [ "$WAIT_UNTIL" -gt 0 ] || { echo "claude-auto: no account available. Run: claude-auto status" >&2; exit 1; }
    secs=$(( WAIT_UNTIL - $(date +%s) + 60 ))
    echo "claude-auto: all accounts full. Waiting $(( secs / 60 )) min for the first reset (Ctrl+C to stop)..." >&2
    sleep $(( secs > 60 ? secs : 60 ))
    pick ""; cur=$PICK; [ -n "$prev" ] && [ -n "$cur" ] && carry "$prev" "$cur" "$sid"; continue
  fi
  echo "claude-auto: using $(label "$cur")" >&2
  rm -f "$CLAUDE_AUTO_FLAG"
  run "$cur" "${args[@]}"
  [ -s "$CLAUDE_AUTO_FLAG" ] || exit 0   # normal exit
  tgt=; { read -r sid; read -r tgt; } < "$CLAUDE_AUTO_FLAG"; prev=$cur
  if [ -n "$tgt" ]; then
    # manual /switch: same session, no extra prompt (print mode needs one)
    echo -e "\nclaude-auto: switching to $(label "$tgt") as asked..." >&2
    cur=$tgt; carry "$prev" "$cur" "$sid"
    args=("${keep[@]}" --resume "$sid")
    [[ " ${keep[*]} " == *" -p "* || " ${keep[*]} " == *" --print "* ]] && args+=("The user moved this session to another Claude account. Continue exactly where you left off; do not start over.")
    continue
  fi
  echo -e "\nclaude-auto: $(name "$cur") hit its usage limit. Switching..." >&2
  pick "$cur"; cur=$PICK
  [ -n "$cur" ] && carry "$prev" "$cur" "$sid"
  args=("${keep[@]}" --resume "$sid" "$RESUME_MSG")
done
